# ==========================================
# Suchetha Kapuarachchi Portfolio - Unified App
# ==========================================

# Flask Environment: 'production' or 'development'
FLASK_ENV=production
FLASK_DEBUG=False

# Host & Port (defaults to 0.0.0.0 and 5000)
HOST=0.0.0.0
PORT=5000

# Security (Change these in production)
SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_EXPIRATION_HOURS=24

# CORS (Comma-separated allowed origins; in unified production, same-origin is automatic)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Upload Limit in bytes (Default: 5MB)
MAX_CONTENT_LENGTH=5242880
