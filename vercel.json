{
  "installCommand": "(python3 -m pip install -r requirements.txt || pip install -r requirements.txt) && npm --prefix frontend install --include=dev",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "app.py": {
      "includeFiles": "backend/**"
    },
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
